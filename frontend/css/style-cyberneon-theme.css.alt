/* =========================================================
   Lingua 语伴 — CYBER NEON theme
   Deep black / midnight navy base, glowing violet-cyan accents,
   dark glassmorphism panels. Same structure/classes as before —
   visual layer only, no functional changes.
   ========================================================= */
:root {
  --bg-black: #05050c;
  --bg-navy: #0a0c1e;
  --bg-navy-2: #10132a;
  --panel: rgba(16, 19, 42, 0.55);
  --panel-solid: #12152e;
  --panel-raised: rgba(24, 28, 56, 0.65);
  --border: rgba(130, 110, 255, 0.22);
  --border-strong: rgba(150, 130, 255, 0.4);
  --border-cyan: rgba(53, 231, 255, 0.35);

  --neon-violet: #8b5cf6;
  --neon-purple: #b05bff;
  --neon-cyan: #35e7ff;
  --neon-cyan-dim: #1fb8cc;
  --glow-violet: rgba(176, 91, 255, 0.45);
  --glow-cyan: rgba(53, 231, 255, 0.35);
  --glow-soft: rgba(139, 92, 246, 0.25);

  --text-primary: #eaf0ff;
  --text-muted: #8f9ac2;
  --text-faint: #565f85;

  --font-ui: 'Inter', system-ui, sans-serif;
  --font-display: 'Orbitron', 'Inter', sans-serif;
  --font-label: 'Rajdhani', 'Inter', sans-serif;
  --font-zh: 'Noto Serif SC', serif;
  --font-ar: 'Noto Naskh Arabic', serif;

  --radius-sm: 10px;
  --radius-md: 16px;
  --radius-lg: 22px;
}

* { box-sizing: border-box; }
html, body { height: 100%; }
body {
  margin: 0;
  font-family: var(--font-ui);
  background: var(--bg-black);
  color: var(--text-primary);
  -webkit-font-smoothing: antialiased;
}

@media (prefers-reduced-motion: reduce) {
  * { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
}

::selection { background: var(--glow-violet); color: #fff; }

/* =========================================================
   App shell — layered neon glow + faint circuit grid
   ========================================================= */
.app {
  position: relative;
  display: flex;
  height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(ellipse 1000px 560px at 10% -5%, rgba(139, 92, 246, 0.16), transparent 60%),
    radial-gradient(ellipse 800px 600px at 105% 105%, rgba(53, 231, 255, 0.10), transparent 60%),
    linear-gradient(180deg, var(--bg-navy) 0%, var(--bg-black) 55%);
}
.app::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.35;
  background-image:
    linear-gradient(rgba(139, 92, 246, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(139, 92, 246, 0.05) 1px, transparent 1px);
  background-size: 42px 42px;
  mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 10%, transparent 75%);
}

/* =========================================================
   Sidebar — dark glass panel
   ========================================================= */
.sidebar {
  position: relative;
  z-index: 2;
  width: 282px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, rgba(14, 16, 36, 0.85), rgba(6, 7, 18, 0.92));
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-right: 1px solid var(--border);
  box-shadow: 1px 0 30px rgba(0, 0, 0, 0.4);
  padding: 20px 16px;
  transition: margin-left 0.25s ease;
}
.sidebar.collapsed { margin-left: -282px; }

.sidebar-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.brand { display: flex; align-items: center; gap: 12px; }
.seal {
  width: 40px; height: 40px;
  border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-zh);
  font-weight: 700;
  font-size: 18px;
  color: #eafcff;
  background: linear-gradient(145deg, var(--neon-violet), var(--neon-cyan-dim));
  border: 1px solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 0 20px var(--glow-violet), 0 0 36px rgba(53, 231, 255, 0.18);
  position: relative;
}
.seal::after {
  content: "";
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  padding: 1px;
  background: linear-gradient(145deg, var(--neon-cyan), transparent 60%);
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  opacity: 0.7;
}
.brand-text { display: flex; flex-direction: column; line-height: 1.3; }
.brand-name {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 14.5px;
  letter-spacing: 0.5px;
  color: var(--text-primary);
}
.brand-zh { font-family: var(--font-zh); color: var(--neon-cyan); text-shadow: 0 0 14px var(--glow-cyan); }
.brand-tag {
  font-family: var(--font-label);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.8px;
  color: var(--text-faint);
}

.icon-btn {
  width: 34px; height: 34px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 10px;
  border: 1px solid transparent;
  background: transparent;
  color: var(--text-muted);
  cursor: pointer;
  transition: background 0.15s, color 0.15s, border-color 0.15s, box-shadow 0.15s;
}
.icon-btn:hover {
  background: var(--panel-raised);
  color: var(--neon-cyan);
  border-color: var(--border-cyan);
  box-shadow: 0 0 12px var(--glow-cyan);
}

.new-chat-btn {
  display: flex; align-items: center; gap: 10px;
  width: 100%;
  padding: 11px 14px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-strong);
  background: linear-gradient(180deg, rgba(139, 92, 246, 0.14), rgba(53, 231, 255, 0.06));
  color: var(--text-primary);
  font-family: var(--font-label);
  font-size: 14.5px;
  font-weight: 600;
  letter-spacing: 0.2px;
  cursor: pointer;
  transition: border-color 0.18s, box-shadow 0.18s, transform 0.12s;
}
.new-chat-btn:hover {
  border-color: var(--neon-purple);
  box-shadow: 0 0 0 1px var(--glow-violet), 0 0 24px var(--glow-soft);
  transform: translateY(-1px);
}

.history-label {
  margin: 22px 4px 8px;
  font-family: var(--font-label);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 1.2px;
  color: var(--text-faint);
}

.history-list {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.history-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 11px;
  border-radius: var(--radius-sm);
  color: var(--text-muted);
  font-size: 13px;
  cursor: pointer;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  border: 1px solid transparent;
  transition: background 0.15s, border-color 0.15s, color 0.15s;
}
.history-item:hover { background: var(--panel-raised); color: var(--text-primary); }
.history-item.active {
  background: linear-gradient(90deg, rgba(139, 92, 246, 0.16), rgba(53, 231, 255, 0.05));
  color: var(--text-primary);
  border-color: var(--border-cyan);
  box-shadow: inset 2px 0 0 var(--neon-cyan);
}
.history-empty { color: var(--text-faint); font-size: 12.5px; padding: 10px; }

.sidebar-bottom {
  border-top: 1px solid var(--border);
  padding-top: 14px;
  margin-top: 10px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.lang-toggle {
  display: flex;
  background: var(--panel-solid);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 3px;
  gap: 2px;
}
.lang-opt {
  flex: 1;
  padding: 7px 0;
  border: none;
  background: transparent;
  color: var(--text-muted);
  border-radius: 7px;
  font-family: var(--font-label);
  font-weight: 600;
  font-size: 12.5px;
  letter-spacing: 0.4px;
  cursor: pointer;
  transition: background 0.15s, color 0.15s, box-shadow 0.15s;
}
.lang-opt.active {
  background: linear-gradient(135deg, var(--neon-violet), var(--neon-cyan-dim));
  color: #fff;
  box-shadow: 0 0 14px var(--glow-violet);
}

.status-row {
  display: flex; align-items: center; gap: 8px;
  font-family: var(--font-label);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.3px;
  color: var(--text-faint);
  padding: 0 2px;
}
.status-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--text-faint);
  flex-shrink: 0;
}
.status-dot.ok { background: var(--neon-cyan); box-shadow: 0 0 8px var(--neon-cyan), 0 0 16px var(--glow-cyan); }
.status-dot.bad { background: #ff4d6d; box-shadow: 0 0 8px #ff4d6d; }

/* =========================================================
   Main column
   ========================================================= */
.main { position: relative; z-index: 1; flex: 1; display: flex; flex-direction: column; min-width: 0; }

.topbar {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 24px;
  flex-shrink: 0;
}
.topbar-spacer { flex: 1; }
.mobile-only { display: none; }

.direction-toggle {
  display: flex; align-items: center; gap: 12px;
  padding: 7px 16px;
  background: var(--panel);
  backdrop-filter: blur(10px);
  border: 1px solid var(--border);
  border-radius: 999px;
}
.dir-label { font-size: 13px; font-weight: 600; color: var(--text-muted); }
.dir-label.dir-ar { font-family: var(--font-ar); }
.dir-label.dir-zh { font-family: var(--font-zh); }
.dir-switch {
  width: 27px; height: 27px;
  border-radius: 50%;
  border: none;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, var(--neon-violet), var(--neon-cyan-dim));
  color: #fff;
  cursor: pointer;
  box-shadow: 0 0 14px var(--glow-violet);
  transition: transform 0.3s, box-shadow 0.2s;
}
.dir-switch:hover { transform: rotate(180deg); box-shadow: 0 0 20px var(--glow-cyan); }

/* =========================================================
   Welcome screen
   ========================================================= */
.welcome {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 24px;
  overflow-y: auto;
}

.welcome-seal {
  width: 80px; height: 80px;
  border-radius: 22px;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-zh);
  font-weight: 700;
  font-size: 38px;
  color: #eafcff;
  background: linear-gradient(150deg, var(--neon-violet), var(--neon-cyan-dim) 85%);
  border: 1px solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 0 50px var(--glow-violet), 0 0 90px rgba(53, 231, 255, 0.15);
  margin-bottom: 24px;
  animation: seal-breathe 4.5s ease-in-out infinite;
}
@keyframes seal-breathe {
  0%, 100% { box-shadow: 0 0 40px var(--glow-violet), 0 0 70px rgba(53, 231, 255, 0.12); }
  50% { box-shadow: 0 0 64px var(--glow-violet), 0 0 110px rgba(53, 231, 255, 0.22); }
}

.welcome-title {
  font-family: var(--font-display);
  font-size: 32px;
  font-weight: 700;
  letter-spacing: 1px;
  margin: 0 0 12px;
  color: var(--text-primary);
}
.zh-accent {
  font-family: var(--font-zh);
  letter-spacing: 0;
  background: linear-gradient(120deg, var(--neon-cyan), var(--neon-purple));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  text-shadow: 0 0 30px var(--glow-cyan);
}

.welcome-subtitle {
  color: var(--text-muted);
  font-size: 15px;
  max-width: 440px;
  line-height: 1.6;
  margin: 0 0 30px;
}

.mode-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 9px;
  margin-bottom: 32px;
}
.chip {
  padding: 8px 18px;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: var(--panel);
  backdrop-filter: blur(8px);
  color: var(--text-muted);
  font-family: var(--font-label);
  font-weight: 600;
  letter-spacing: 0.3px;
  font-size: 13.5px;
  cursor: pointer;
  transition: border-color 0.18s, color 0.18s, background 0.18s, box-shadow 0.18s;
}
.chip:hover { color: var(--text-primary); border-color: var(--border-cyan); box-shadow: 0 0 14px var(--glow-cyan); }
.chip.active {
  color: #fff;
  border-color: transparent;
  background: linear-gradient(135deg, var(--neon-violet), var(--neon-cyan-dim));
  box-shadow: 0 0 20px var(--glow-violet);
}
.chip.small { padding: 6px 14px; font-size: 12.5px; }

.suggestions {
  display: grid;
  grid-template-columns: repeat(2, minmax(230px, 270px));
  gap: 14px;
  max-width: 580px;
}
.suggestion-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 5px;
  text-align: left;
  padding: 16px 18px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border);
  background: var(--panel);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: var(--text-primary);
  cursor: pointer;
  overflow: hidden;
  transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
}
.suggestion-card::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.10), transparent 60%);
  opacity: 0;
  transition: opacity 0.2s;
}
.suggestion-card:hover {
  border-color: var(--neon-cyan);
  box-shadow: 0 0 0 1px var(--border-cyan), 0 10px 30px -14px var(--glow-cyan);
  transform: translateY(-2px);
}
.suggestion-card:hover::before { opacity: 1; }
.s-title { font-family: var(--font-label); font-size: 14.5px; font-weight: 700; letter-spacing: 0.2px; }
.s-sub { font-size: 12px; color: var(--text-faint); }

/* =========================================================
   Chat view
   ========================================================= */
.chat-view { flex: 1; overflow-y: auto; }
.messages {
  max-width: 760px;
  margin: 0 auto;
  padding: 10px 24px 30px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.msg { display: flex; gap: 12px; animation: msg-in 0.28s ease; max-width: 100%; }
@keyframes msg-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

.msg.user { flex-direction: row-reverse; }
.msg-avatar {
  width: 32px; height: 32px; border-radius: 10px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-zh); font-size: 14px; font-weight: 700;
}
.msg.bot .msg-avatar {
  background: linear-gradient(150deg, var(--neon-violet), var(--neon-cyan-dim));
  color: #eafcff;
  box-shadow: 0 0 14px var(--glow-violet);
}
.msg.user .msg-avatar {
  background: var(--panel-raised);
  color: var(--text-muted);
  border: 1px solid var(--border);
}

.msg-bubble {
  padding: 13px 17px;
  border-radius: var(--radius-md);
  line-height: 1.65;
  font-size: 14.5px;
  max-width: 540px;
  white-space: pre-wrap;
  word-wrap: break-word;
}
.msg.bot .msg-bubble {
  background: var(--panel);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid var(--border);
  border-top-left-radius: 4px;
}
.msg.user .msg-bubble {
  background: linear-gradient(135deg, var(--neon-violet), var(--neon-cyan-dim));
  color: #fff;
  border-top-right-radius: 4px;
  box-shadow: 0 0 22px var(--glow-soft);
}
.msg-bubble[dir="rtl"] { font-family: var(--font-ar); font-size: 16px; text-align: right; }

.msg-bubble .typing-cursor {
  display: inline-block;
  width: 7px; height: 15px;
  background: var(--neon-cyan);
  box-shadow: 0 0 8px var(--neon-cyan);
  margin-left: 2px;
  vertical-align: text-bottom;
  animation: blink 0.9s step-start infinite;
}
@keyframes blink { 50% { opacity: 0; } }

.msg-error {
  color: #ff9eb0;
  font-size: 13px;
  border: 1px solid rgba(255, 77, 109, 0.4) !important;
  background: rgba(255, 77, 109, 0.08) !important;
}

/* =========================================================
   Composer
   ========================================================= */
.composer {
  flex-shrink: 0;
  padding: 14px 24px 20px;
  border-top: 1px solid var(--border);
  background: linear-gradient(180deg, transparent, rgba(5, 5, 12, 0.5));
}
.composer-modes {
  max-width: 760px;
  margin: 0 auto 10px;
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}
.composer-box {
  max-width: 760px;
  margin: 0 auto;
  display: flex;
  align-items: flex-end;
  gap: 10px;
  background: var(--panel);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-lg);
  padding: 10px 10px 10px 18px;
  transition: box-shadow 0.18s, border-color 0.18s;
}
.composer-box:focus-within {
  border-color: var(--neon-cyan);
  box-shadow: 0 0 0 3px rgba(53, 231, 255, 0.15), 0 0 30px var(--glow-soft);
}

#messageInput {
  flex: 1;
  resize: none;
  border: none;
  background: transparent;
  color: var(--text-primary);
  font-family: var(--font-ui);
  font-size: 14.5px;
  line-height: 1.5;
  max-height: 160px;
  padding: 6px 0;
  outline: none;
}
#messageInput::placeholder { color: var(--text-faint); }

.send-btn {
  width: 39px; height: 39px;
  flex-shrink: 0;
  border-radius: 50%;
  border: none;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, var(--neon-violet), var(--neon-cyan-dim));
  color: #fff;
  cursor: pointer;
  box-shadow: 0 0 16px var(--glow-violet);
  transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
}
.send-btn:hover { transform: scale(1.07); box-shadow: 0 0 24px var(--glow-cyan); }
.send-btn:disabled { opacity: 0.4; cursor: default; transform: none; box-shadow: none; }

.composer-hint {
  max-width: 760px;
  margin: 10px auto 0;
  text-align: center;
  font-family: var(--font-label);
  font-size: 11.5px;
  font-weight: 600;
  letter-spacing: 0.3px;
  color: var(--text-faint);
}

/* =========================================================
   RTL support (Arabic UI mode)
   ========================================================= */
body.ui-ar { direction: rtl; }
body.ui-ar .sidebar { border-right: none; border-left: 1px solid var(--border); }
body.ui-ar .new-chat-btn svg,
body.ui-ar .msg.user { flex-direction: row; }
body.ui-ar .welcome-title,
body.ui-ar .welcome-subtitle { font-family: var(--font-ar); }

/* =========================================================
   Scrollbars
   ========================================================= */
.history-list::-webkit-scrollbar, .chat-view::-webkit-scrollbar, .welcome::-webkit-scrollbar { width: 7px; }
.history-list::-webkit-scrollbar-thumb, .chat-view::-webkit-scrollbar-thumb, .welcome::-webkit-scrollbar-thumb {
  background: linear-gradient(var(--neon-violet), var(--neon-cyan-dim));
  border-radius: 10px;
  opacity: 0.6;
}

/* =========================================================
   Responsive
   ========================================================= */
.sidebar-overlay { display: none; }

@media (max-width: 860px) {
  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 30;
    margin-left: -282px;
  }
  .sidebar.open { margin-left: 0; box-shadow: 0 0 50px rgba(0,0,0,0.6); }
  .mobile-only { display: flex; }
  .sidebar-overlay.show {
    display: block;
    position: fixed; inset: 0;
    background: rgba(2, 2, 8, 0.6);
    backdrop-filter: blur(2px);
    z-index: 25;
  }
  .suggestions { grid-template-columns: 1fr; }
  .msg-bubble { max-width: 100%; }
}
