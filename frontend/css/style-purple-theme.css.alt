/* =========================================================
   Lingua 语伴 — design tokens
   Deep purple base with a muted cinnabar-red seal accent and
   antique gold hairlines — evoking ink, lacquer, and a wax seal.
   ========================================================= */
:root {
  --bg-void: #0a0614;
  --bg-primary: #130d22;
  --bg-elevated: #1b1430;
  --bg-elevated-2: #241a3c;
  --border: rgba(167, 128, 255, 0.14);
  --border-strong: rgba(167, 128, 255, 0.28);

  --accent: #9b6dff;
  --accent-soft: #6d4fd1;
  --accent-glow: rgba(155, 109, 255, 0.35);
  --gold: #d8b473;
  --seal: #b5394a;
  --seal-glow: rgba(181, 57, 74, 0.45);

  --text-primary: #ece6f7;
  --text-muted: #9c91b8;
  --text-faint: #675d85;

  --font-ui: 'Inter', system-ui, sans-serif;
  --font-zh: 'Noto Serif SC', serif;
  --font-ar: 'Noto Naskh Arabic', serif;

  --radius-sm: 10px;
  --radius-md: 14px;
  --radius-lg: 20px;
}

* { box-sizing: border-box; }
html, body { height: 100%; }
body {
  margin: 0;
  font-family: var(--font-ui);
  background: var(--bg-void);
  color: var(--text-primary);
  -webkit-font-smoothing: antialiased;
}

@media (prefers-reduced-motion: reduce) {
  * { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
}

/* =========================================================
   App shell
   ========================================================= */
.app {
  display: flex;
  height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(ellipse 900px 500px at 15% 0%, rgba(155, 109, 255, 0.10), transparent 60%),
    radial-gradient(ellipse 700px 500px at 100% 100%, rgba(181, 57, 74, 0.08), transparent 60%),
    var(--bg-void);
}

/* =========================================================
   Sidebar
   ========================================================= */
.sidebar {
  width: 280px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, var(--bg-primary), var(--bg-void));
  border-right: 1px solid var(--border);
  padding: 20px 16px;
  transition: margin-left 0.25s ease;
}
.sidebar.collapsed { margin-left: -280px; }

.sidebar-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.brand { display: flex; align-items: center; gap: 12px; }
.seal {
  width: 38px; height: 38px;
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-zh);
  font-weight: 700;
  font-size: 18px;
  color: #f5e9d8;
  background: radial-gradient(circle at 30% 20%, var(--seal), #7c2230 80%);
  box-shadow: 0 0 18px var(--seal-glow);
}
.brand-text { display: flex; flex-direction: column; line-height: 1.25; }
.brand-name { font-weight: 600; font-size: 15px; letter-spacing: 0.2px; }
.brand-zh { font-family: var(--font-zh); color: var(--gold); }
.brand-tag { font-size: 11px; color: var(--text-faint); }

.icon-btn {
  width: 34px; height: 34px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 8px;
  border: 1px solid transparent;
  background: transparent;
  color: var(--text-muted);
  cursor: pointer;
  transition: background 0.15s, color 0.15s, border-color 0.15s;
}
.icon-btn:hover { background: var(--bg-elevated); color: var(--text-primary); border-color: var(--border); }

.new-chat-btn {
  display: flex; align-items: center; gap: 10px;
  width: 100%;
  padding: 11px 14px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-strong);
  background: linear-gradient(180deg, var(--bg-elevated-2), var(--bg-elevated));
  color: var(--text-primary);
  font-family: var(--font-ui);
  font-size: 13.5px;
  font-weight: 500;
  cursor: pointer;
  transition: border-color 0.15s, box-shadow 0.15s;
}
.new-chat-btn:hover { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent-glow); }

.history-label {
  margin: 22px 4px 8px;
  font-size: 11.5px;
  color: var(--text-faint);
  letter-spacing: 0.3px;
}

.history-list {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.history-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 10px;
  border-radius: var(--radius-sm);
  color: var(--text-muted);
  font-size: 13px;
  cursor: pointer;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  border: 1px solid transparent;
}
.history-item:hover { background: var(--bg-elevated); color: var(--text-primary); }
.history-item.active {
  background: var(--bg-elevated-2);
  color: var(--text-primary);
  border-color: var(--border);
}
.history-empty { color: var(--text-faint); font-size: 12.5px; padding: 10px; }

.sidebar-bottom {
  border-top: 1px solid var(--border);
  padding-top: 14px;
  margin-top: 10px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.lang-toggle {
  display: flex;
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 3px;
  gap: 2px;
}
.lang-opt {
  flex: 1;
  padding: 7px 0;
  border: none;
  background: transparent;
  color: var(--text-muted);
  border-radius: 7px;
  font-family: var(--font-ui);
  font-size: 12.5px;
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
}
.lang-opt.active {
  background: linear-gradient(180deg, var(--accent), var(--accent-soft));
  color: #fff;
}

.status-row {
  display: flex; align-items: center; gap: 8px;
  font-size: 11.5px;
  color: var(--text-faint);
  padding: 0 2px;
}
.status-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--text-faint);
  flex-shrink: 0;
}
.status-dot.ok { background: #5fd98a; box-shadow: 0 0 6px #5fd98a; }
.status-dot.bad { background: var(--seal); box-shadow: 0 0 6px var(--seal); }

/* =========================================================
   Main column
   ========================================================= */
.main { flex: 1; display: flex; flex-direction: column; min-width: 0; }

.topbar {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 24px;
  flex-shrink: 0;
}
.topbar-spacer { flex: 1; }
.mobile-only { display: none; }

.direction-toggle {
  display: flex; align-items: center; gap: 12px;
  padding: 7px 14px;
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: 999px;
}
.dir-label { font-size: 13px; color: var(--text-muted); }
.dir-label.dir-ar { font-family: var(--font-ar); }
.dir-label.dir-zh { font-family: var(--font-zh); }
.dir-switch {
  width: 26px; height: 26px;
  border-radius: 50%;
  border: none;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(180deg, var(--accent), var(--accent-soft));
  color: #fff;
  cursor: pointer;
  transition: transform 0.2s;
}
.dir-switch:hover { transform: rotate(180deg); }

/* =========================================================
   Welcome screen
   ========================================================= */
.welcome {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 24px;
  overflow-y: auto;
}

.welcome-seal {
  width: 76px; height: 76px;
  border-radius: 20px;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-zh);
  font-weight: 700;
  font-size: 36px;
  color: #f7ecdd;
  background: radial-gradient(circle at 30% 25%, var(--seal), #6a1c28 85%);
  box-shadow: 0 0 46px var(--seal-glow), 0 0 0 1px rgba(255,255,255,0.05) inset;
  margin-bottom: 22px;
  animation: seal-breathe 5s ease-in-out infinite;
}
@keyframes seal-breathe {
  0%, 100% { box-shadow: 0 0 36px var(--seal-glow), 0 0 0 1px rgba(255,255,255,0.05) inset; }
  50% { box-shadow: 0 0 56px var(--seal-glow), 0 0 0 1px rgba(255,255,255,0.08) inset; }
}

.welcome-title {
  font-size: 34px;
  font-weight: 700;
  margin: 0 0 10px;
  letter-spacing: 0.2px;
}
.zh-accent { font-family: var(--font-zh); color: var(--gold); }

.welcome-subtitle {
  color: var(--text-muted);
  font-size: 15px;
  max-width: 440px;
  line-height: 1.6;
  margin: 0 0 28px;
}

.mode-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  margin-bottom: 30px;
}
.chip {
  padding: 8px 16px;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: var(--bg-elevated);
  color: var(--text-muted);
  font-family: var(--font-ui);
  font-size: 13px;
  cursor: pointer;
  transition: border-color 0.15s, color 0.15s, background 0.15s;
}
.chip:hover { color: var(--text-primary); border-color: var(--border-strong); }
.chip.active {
  color: #fff;
  border-color: transparent;
  background: linear-gradient(135deg, var(--accent), var(--accent-soft));
}
.chip.small { padding: 6px 13px; font-size: 12px; }

.suggestions {
  display: grid;
  grid-template-columns: repeat(2, minmax(220px, 260px));
  gap: 12px;
  max-width: 560px;
}
.suggestion-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
  text-align: left;
  padding: 14px 16px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border);
  background: var(--bg-elevated);
  color: var(--text-primary);
  cursor: pointer;
  transition: border-color 0.18s, box-shadow 0.18s, transform 0.18s;
}
.suggestion-card:hover {
  border-color: var(--accent);
  box-shadow: 0 0 0 1px var(--accent-glow), 0 8px 24px -12px var(--accent-glow);
  transform: translateY(-1px);
}
.s-title { font-size: 13.5px; font-weight: 600; }
.s-sub { font-size: 12px; color: var(--text-faint); }

/* =========================================================
   Chat view
   ========================================================= */
.chat-view { flex: 1; overflow-y: auto; }
.messages {
  max-width: 760px;
  margin: 0 auto;
  padding: 10px 24px 30px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.msg { display: flex; gap: 12px; animation: msg-in 0.25s ease; max-width: 100%; }
@keyframes msg-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

.msg.user { flex-direction: row-reverse; }
.msg-avatar {
  width: 30px; height: 30px; border-radius: 9px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-zh); font-size: 14px; font-weight: 700;
}
.msg.bot .msg-avatar { background: radial-gradient(circle at 30% 25%, var(--seal), #6a1c28 85%); color: #f7ecdd; }
.msg.user .msg-avatar { background: var(--bg-elevated-2); color: var(--text-muted); border: 1px solid var(--border); }

.msg-bubble {
  padding: 12px 16px;
  border-radius: var(--radius-md);
  line-height: 1.65;
  font-size: 14.5px;
  max-width: 540px;
  white-space: pre-wrap;
  word-wrap: break-word;
}
.msg.bot .msg-bubble {
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-top-left-radius: 4px;
}
.msg.user .msg-bubble {
  background: linear-gradient(135deg, var(--accent-soft), var(--accent));
  color: #fff;
  border-top-right-radius: 4px;
}
.msg-bubble[dir="rtl"] { font-family: var(--font-ar); font-size: 16px; text-align: right; }

.msg-bubble .typing-cursor {
  display: inline-block;
  width: 7px; height: 15px;
  background: var(--accent);
  margin-left: 2px;
  vertical-align: text-bottom;
  animation: blink 0.9s step-start infinite;
}
@keyframes blink { 50% { opacity: 0; } }

.msg-error {
  color: #f2a0ab;
  font-size: 13px;
  border: 1px solid rgba(181,57,74,0.4);
  background: rgba(181,57,74,0.08);
}

/* =========================================================
   Composer
   ========================================================= */
.composer {
  flex-shrink: 0;
  padding: 14px 24px 20px;
  border-top: 1px solid var(--border);
  background: linear-gradient(180deg, transparent, rgba(10,6,20,0.4));
}
.composer-modes {
  max-width: 760px;
  margin: 0 auto 10px;
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}
.composer-box {
  max-width: 760px;
  margin: 0 auto;
  display: flex;
  align-items: flex-end;
  gap: 10px;
  background: var(--bg-elevated);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-lg);
  padding: 10px 10px 10px 18px;
  transition: box-shadow 0.15s, border-color 0.15s;
}
.composer-box:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }

#messageInput {
  flex: 1;
  resize: none;
  border: none;
  background: transparent;
  color: var(--text-primary);
  font-family: var(--font-ui);
  font-size: 14.5px;
  line-height: 1.5;
  max-height: 160px;
  padding: 6px 0;
  outline: none;
}
#messageInput::placeholder { color: var(--text-faint); }

.send-btn {
  width: 38px; height: 38px;
  flex-shrink: 0;
  border-radius: 50%;
  border: none;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, var(--accent), var(--accent-soft));
  color: #fff;
  cursor: pointer;
  transition: transform 0.15s, opacity 0.15s;
}
.send-btn:hover { transform: scale(1.06); }
.send-btn:disabled { opacity: 0.4; cursor: default; transform: none; }

.composer-hint {
  max-width: 760px;
  margin: 10px auto 0;
  text-align: center;
  font-size: 11.5px;
  color: var(--text-faint);
}

/* =========================================================
   RTL support (Arabic UI mode)
   ========================================================= */
body.ui-ar { direction: rtl; }
body.ui-ar .sidebar { border-right: none; border-left: 1px solid var(--border); }
body.ui-ar .new-chat-btn svg,
body.ui-ar .msg.user { flex-direction: row; }
body.ui-ar .welcome-title,
body.ui-ar .welcome-subtitle { font-family: var(--font-ar); }

/* =========================================================
   Scrollbars
   ========================================================= */
.history-list::-webkit-scrollbar, .chat-view::-webkit-scrollbar, .welcome::-webkit-scrollbar { width: 7px; }
.history-list::-webkit-scrollbar-thumb, .chat-view::-webkit-scrollbar-thumb, .welcome::-webkit-scrollbar-thumb {
  background: var(--bg-elevated-2);
  border-radius: 10px;
}

/* =========================================================
   Responsive
   ========================================================= */
.sidebar-overlay { display: none; }

@media (max-width: 860px) {
  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 30;
    margin-left: -280px;
  }
  .sidebar.open { margin-left: 0; box-shadow: 0 0 40px rgba(0,0,0,0.5); }
  .mobile-only { display: flex; }
  .sidebar-overlay.show {
    display: block;
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 25;
  }
  .suggestions { grid-template-columns: 1fr; }
  .msg-bubble { max-width: 100%; }
}
